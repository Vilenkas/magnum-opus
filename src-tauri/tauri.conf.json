{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Magnum Opus",
  "version": "0.1.0",
  "identifier": "com.magnumopus.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Magnum Opus",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0d0c0a"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Enciclopedia personal interactiva",
    "longDescription": "Magnum Opus: una enciclopedia personal, offline e interactiva, donde cada tema tiene su propio diseño.",
    "category": "Education",
    "copyright": "Modelos anatómicos derivados de Z-Anatomy (CC BY-SA 4.0) y BodyParts3D (CC BY-SA 2.1 JP)",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
